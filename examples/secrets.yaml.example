# Copy to secrets.yaml and edit. Never commit the real file.
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
ota_password: "CHANGE_ME"
ap_password: "CHANGE_ME_TOO"

# URL reachable from the ESP32. For the local server in docs/INSTALL.md:
#   cd firmware && python3 -m http.server 8000
# then use http://<your-computer-ip>:8000/nspanel-v92-blank.tft
tft_url: "http://192.168.1.10:8000/nspanel-v92-blank.tft"
